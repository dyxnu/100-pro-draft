# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Dashboard → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# URL pública do site (usada nos links de e-mail de confirmação e recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Só para o servidor (NUNCA exponha no navegador; nunca use o prefixo NEXT_PUBLIC_).
# É a "Secret key" (sb_secret_...) em Project Settings → API Keys. Necessária para salas e leilão.
SUPABASE_SECRET_KEY=
